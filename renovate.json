{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "ignorePaths": [
    "**/vars/cluster-secrets.yaml",
    "cluster-talos/kubernetes/bootstrap/flux-system/gotk-components.yaml"
  ],
  "kubernetes": {
    "managerFilePatterns": ["/^cluster-talos/.+\\.ya?ml$/"],
    "ignorePaths": ["cluster-talos/talos/nodes/patches/**"]
  },
  "flux": {
    "managerFilePatterns": ["/^cluster-talos/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Talos installer version in talm values.yaml",
      "managerFilePatterns": ["/^cluster-talos/talos/values\\.yaml$/"],
      "matchStrings": [
        "version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "siderolabs/talos"
    },
    {
      "customType": "regex",
      "description": "Kubernetes/kubelet version pin in talm values.yaml",
      "managerFilePatterns": ["/^cluster-talos/talos/values\\.yaml$/"],
      "matchStrings": [
        "kubernetesVersion:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/siderolabs/kubelet"
    },
    {
      "customType": "regex",
      "description": "Cilium version in bootstrap Makefile",
      "managerFilePatterns": ["/^cluster-talos/talos/Makefile$/"],
      "matchStrings": [
        "--version\\s+(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://helm.cilium.io",
      "depNameTemplate": "cilium"
    },
    {
      "customType": "regex",
      "description": "flux-operator distribution manifests artifact (sets the actual Flux controller version)",
      "managerFilePatterns": ["/^cluster-talos/kubernetes/infrastructure/flux-system/flux-instance/app/helmrelease\\.yaml$/"],
      "matchStrings": [
        "artifact:\\s*oci://(?<depName>ghcr\\.io/controlplaneio-fluxcd/flux-operator-manifests):(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Sonarr upstream STABLE release tracker (GitHub releases; prereleases ignored) - signals when the sonarr image cap can be lifted",
      "managerFilePatterns": ["/^cluster-talos/kubernetes/apps/arr/sonarr/app/helmrelease\\.yaml$/"],
      "matchStrings": [
        "#\\s*sonarr-upstream-stable:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "Sonarr/Sonarr",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Pinned ARG versions in custom image Dockerfiles",
      "managerFilePatterns": [
        "/^cluster-talos/kubernetes/apps/.+/image/Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+versioning=(?<versioning>[a-z-]+))?\\s*\\nARG\\s+[A-Z0-9_]+=(?<currentValue>[^\\s\"]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Tuppr CR version pins (TalosUpgrade, KubernetesUpgrade)",
      "managerFilePatterns": [
        "/^cluster-talos/kubernetes/infrastructure/platform/tuppr/upgrades/.+\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+versioning=(?<versioning>[a-z-]+))?\\s*\\n\\s*version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group all .mise.toml toolchain bumps into one PR to avoid intra-file conflicts",
      "matchFileNames": [".mise.toml"],
      "groupName": "mise toolchain"
    },
    {
      "matchManagers": ["flux"],
      "groupName": "helm charts",
      "automerge": false
    },
    {
      "description": "Flux operator + instance charts + distribution manifests move together, out of the big helm-charts group",
      "matchPackageNames": ["ghcr.io/controlplaneio-fluxcd/**"],
      "groupName": "flux operator",
      "automerge": false
    },
    {
      "description": "Talos version pins (talm values + tuppr TalosUpgrade). ghcr.io/siderolabs/installer is no longer published from Talos 1.14, so tuppr tracks ghcr.io/siderolabs/talos",
      "matchDepNames": [
        "siderolabs/talos",
        "ghcr.io/siderolabs/talos"
      ],
      "matchFileNames": ["cluster-talos/**"],
      "groupName": "cluster-talos infra",
      "automerge": false
    },
    {
      "description": "Cilium (HelmRelease + bootstrap Makefile) on its own: upgrades need Gateway API CRD prereqs and per-minor stepping, never bundled with a Talos roll",
      "matchDepNames": ["cilium"],
      "matchFileNames": ["cluster-talos/**"],
      "groupName": "cilium",
      "automerge": false
    },
    {
      "description": "Cluster upgrade PRs must always come back, even after manual close",
      "matchDepNames": [
        "siderolabs/talos",
        "ghcr.io/siderolabs/talos",
        "ghcr.io/siderolabs/kubelet"
      ],
      "recreateWhen": "always"
    },
    {
      "description": "vSphere CSI pins its own sidecar versions; bump as bundle with the driver",
      "matchFileNames": ["cluster-talos/kubernetes/infrastructure/core/vsphere-csi/**"],
      "matchPackageNames": ["registry.k8s.io/sig-storage/**"],
      "enabled": false
    },
    {
      "description": "Split risky major helm bumps into per-chart PRs",
      "matchManagers": ["flux"],
      "matchUpdateTypes": ["major"],
      "matchDepNames": [
        "external-secrets",
        "netbox",
        "prometheus",
        "ghcr.io/varashi/charts/gpu-node-vsphere-maintenance-controller"
      ],
      "groupName": null
    },
    {
      "description": "LSIO images use 4-part tags with git-hash and -lsNNN suffix; default docker versioning can't parse",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/linuxserver/**"],
      "versioning": "loose",
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+(\\.\\d+)?(-[a-z0-9]+)*-ls\\d+$/"
    },
    {
      "description": "Sonarr image: hold below v5 until v5 is a stable upstream release (home-operations tags v5 betas as plain 5.0.0). Remove once the Sonarr/Sonarr v5 tracker PR appears (#254).",
      "matchPackageNames": ["ghcr.io/home-operations/sonarr"],
      "allowedVersions": "<5.0.0"
    },
    {
      "description": "Sonarr upstream tracker: only a new stable MAJOR matters (minor/patch handled by the image dep)",
      "matchDepNames": ["Sonarr/Sonarr"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": false
    },
    {
      "description": "Sonarr upstream tracker: stable new major published -> lift the image cap",
      "matchDepNames": ["Sonarr/Sonarr"],
      "matchUpdateTypes": ["major"],
      "commitMessageTopic": "Sonarr stable major (lift image cap)",
      "prBodyNotes": ["**Sonarr has a new STABLE major release.** To upgrade: remove the `allowedVersions: \"<5.0.0\"` rule for `ghcr.io/home-operations/sonarr` in `renovate.json` (Renovate then opens the image PR), review the v5 compatibility notes in #254, back up `sonarr-pg`/`sonarr-nl-pg`, canary on sonarr-nl first. Merging this PR only updates the tracker comment."]
    },
    {
      "description": "Auto-merge home-operations image digest rebuilds",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/home-operations/**"],
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    },
    {
      "description": "Self-hosted apps: own PR group, kept out of the infra helm-charts group",
      "matchFileNames": [
        "cluster-talos/kubernetes/apps/arr/autobrr/**",
        "cluster-talos/kubernetes/apps/downloaders/qbittorrent/**",
        "cluster-talos/kubernetes/apps/downloaders/sabnzbd/**",
        "cluster-talos/kubernetes/apps/media/tautulli/**",
        "cluster-talos/kubernetes/apps/media/tdarr/**",
        "cluster-talos/kubernetes/apps/tools/homepage/**",
        "cluster-talos/kubernetes/apps/tools/ocis/**"
      ],
      "groupName": "self-hosted apps"
    },
    {
      "description": "Auto-merge self-hosted app image bumps (3-day cooldown, CI must pass)",
      "matchFileNames": [
        "cluster-talos/kubernetes/apps/arr/autobrr/**",
        "cluster-talos/kubernetes/apps/downloaders/qbittorrent/**",
        "cluster-talos/kubernetes/apps/downloaders/sabnzbd/**",
        "cluster-talos/kubernetes/apps/media/tautulli/**",
        "cluster-talos/kubernetes/apps/media/tdarr/**",
        "cluster-talos/kubernetes/apps/tools/homepage/**",
        "cluster-talos/kubernetes/apps/tools/ocis/**"
      ],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "3 days",
      "ignoreTests": false
    },
    {
      "description": "Plex: own PR, manual merge (verify scaleplex compatibility)",
      "matchFileNames": ["cluster-talos/kubernetes/apps/media/plex/**"],
      "groupName": "plex",
      "automerge": false
    },
    {
      "description": "Plex-test: own PR, manual merge (verify scaleplex compatibility)",
      "matchFileNames": ["cluster-talos/kubernetes/apps/media/plex-test/**"],
      "groupName": "plex-test",
      "automerge": false
    },
    {
      "description": "Auto-merge GitHub Actions with 3-day cooldown",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch",
      "minimumReleaseAge": "3 days",
      "ignoreTests": true
    },
    {
      "description": "Auto-merge trusted GitHub Actions publishers without cooldown",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/**", "fluxcd/**", "renovatebot/**"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch",
      "minimumReleaseAge": "1 minute",
      "ignoreTests": true
    }
  ]
}
